# Environment Configuration
PROJECT_NAME="Web-Based Period-Wise Student Attendance Management"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=capstone-super-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL with SQLite fallback for initial setup)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db
# For SQLite local fallback during testing: sqlite:///./attendance.db

# Camera & ML Recognition Configuration
CAMERA_INDEX=0
PROCESS_EVERY_N_FRAMES=3
CONSECUTIVE_FRAMES_REQUIRED=3
COSINE_DISTANCE_THRESHOLD=0.45
FACE_DETECTION_CONFIDENCE=0.80

# Paths
MODELS_DIR=./data/models
EMBEDDINGS_DIR=./data/embeddings
REPORTS_DIR=./data/reports

# CORS Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
